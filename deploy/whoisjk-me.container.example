# Retired example: production deploys through Cloudflare Workers Builds.
# Configure Turnstile and contact delivery in the Cloudflare Dashboard; do not add
# provider credentials to this legacy Quadlet.

[Unit]
Description=whoisjk.me Astro application
After=network-online.target

[Container]
Image=localhost/whoisjk-me:release
ContainerName=whoisjk-me
Network=caddy.network
PublishPort=127.0.0.1:4321:4321
Environment=HOST=0.0.0.0
Environment=PORT=4321
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
ReadOnlyTmpfs=true
Tmpfs=/tmp

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
