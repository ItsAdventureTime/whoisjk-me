{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whoisjk-me",
  "keep_vars": true,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "900101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
