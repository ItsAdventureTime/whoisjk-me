{
  "name": "whoisjk-me",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "cf:types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "cf:types:check": "wrangler types worker-configuration.d.ts --include-runtime=false --check",
    "check": "pnpm run cf:types:check && astro check",
    "cf:dev": "pnpm run build && wrangler dev",
    "cf:deploy": "pnpm run build && wrangler deploy",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "pnpm run check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "astro": "7.2.9",
    "typescript": "6.0.3",
    "wrangler": "4.127.1"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "gsap": "3.15.0"
  }
}
